# ==============================================================================
# CONFIGURACIÓN DE SUPABASE Y DISCORD OAUTH
# ==============================================================================

# URL de tu proyecto Supabase (en Project Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon Public Key de Supabase (en Project Settings > API)
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Nombre de tu servidor o comunidad de Minecraft
VITE_APP_NAME="MineCoords Community"

# IP del servidor de Minecraft para mostrar en el Dashboard
VITE_MC_SERVER_IP=mc.tudominio.com
VITE_MC_SERVER_VERSION="1.21.x Java & Bedrock"
